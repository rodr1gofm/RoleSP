# Copie para .env (local) e NUNCA envie o .env para o GitHub.
# No Render, estas variáveis são cadastradas no painel do serviço (Environment).

# Connection string do Neon (versão "pooled"), sem channel_binding. Ex.:
# postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Senha da curadoria: 12+ caracteres, única, só sua equipe sabe. Sem ela as rotas /api/admin ficam desativadas.
ADMIN_PASSWORD=

# Endereços do site autorizados a chamar a API, separados por vírgula (sem barra no final).
# Ex.: http://localhost:5500,https://rolesp.onrender.com
ALLOWED_ORIGIN=

# Só para teste local com Postgres sem SSL. Deixe vazio com o Neon.
# PGSSL=off
